        -->
        <activity
            android:name=".TerminalActivity"
            android:exported="false"
            android:label="容器终端"
            android:windowSoftInputMode="adjustResize" />

        <!-- 「手机权限」大类：把手机控制/白名单/插件市场/常驻服务/内核升级/桌面图标收在一起 -->
        <activity
            android:name=".PhonePermActivity"
            android:exported="false"
            android:label="手机权限" />

        <!--
          录制屏幕内声音：**只负责向系统要投影令牌**，拿到就自己结束。
          半透明主题 + 不进最近任务 —— 用户不该看到任何界面，只看到系统确认框。
        -->
        <activity
            android:name=".AudioCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          DSH 内置输入法：唯一目的是"用键盘的方式"把文字送进微信这类
          会拦截 ACTION_SET_TEXT / input text 的应用。

          它平时不该被用户选中 —— App 会在需要时用 WRITE_SECURE_SETTINGS
          临时把默认输入法切到它，用完再切回用户原来的那个。
          BIND_INPUT_METHOD 是系统要求的权限，只有系统能绑，别的应用绑不上。
        -->
        <service
            android:name=".DshImeService"
            android:exported="true"
            android:label="DSH 输入"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!--
          Shizuku 客户端必需的一环：Shizuku 通过这个 ContentProvider 把 binder 交给本应用。
          android:permission=INTERACT_ACROSS_USERS_FULL 是为了**阻止普通应用**访问它 ——
          这是 Shizuku 官方文档规定的写法，不是我们额外要的权限。
          没有装 Shizuku 的手机上，这个 provider 就是静静地待着，不会报错。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
          「用别的应用打开」必需的 FileProvider。

          为什么不能直接把 file:// 塞进 Intent：本 App 的 targetSdk = 28，
          Android 7.0 起对 targetSdk ≥ 24 的应用会抛 FileUriExposedException。
          所以必须换成 content:// 并临时授予读权限，见 {@link OpenWith}。

          exported=false + grantUriPermissions=true 是标准组合：
          别的应用拿不到这个 provider，只能通过我们显式授权的那一个 URI 读。
          能暴露哪些目录由 res/xml/file_paths.xml 决定。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
