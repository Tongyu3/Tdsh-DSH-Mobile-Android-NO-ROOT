        android:name=".DshApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:largeHeap="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!--
          MainActivity 本身**不再挂 LAUNCHER**，桌面入口交给下面那组 activity-alias。

          ⚠️ 为什么要用别名：Android 不允许第三方 App 运行时换桌面图标 ——
          manifest 里的 android:icon 必须是**编译进 APK 的资源**。
          唯一可行的办法就是预先声明好几个 entry，每个带不同图标，
          再用 PackageManager.setComponentEnabledSetting 只启用其中一个。

          MainActivity 仍然 exported=true：老版本留下的桌面快捷方式指向的就是它，
          不改的话用户升级后那一个图标会点不开。
        -->
        <!--
          ⚠️ **launchMode 必须是 singleTask**（2026-10-15 修，GitHub issue #3）。

          原来没设，走默认 standard —— 每次 startActivity 都**新建一个 MainActivity 实例**：
            · 点通知栏「正在运行」→ 新实例 → 新 WebView → 全新加载 → 没有会话的落地页
            · 桌面图标有 30 个 activity-alias 都指向本 Activity，从不同图标进来也会各开一个
            · 新实例是空白会话页，旧实例还活着 —— 用户看到的"像两个独立应用实例、
              返回键像在退出另一个应用"就是两个实例叠在任务栈里
            · 「返回两次才恢复」= 正在弹出第二个实例

          singleTask 之后全局只有一个实例：再次启动只走 onNewIntent 把它提前，
          WebView 和当前会话原样保留，不会重新加载。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|layoutDirection|locale|mcc|mnc|touchscreen"
            android:label="@string/app_name" />

        <!--
          桌面图标可选配色。同一套前景图（那只鲸鱼），只换背景色。
          一次只启用一个 —— 由 IconSwitcher.apply() 保证，
          而且要**先启用新的、再禁用旧的**，中间不能出现"一个都没启用"的空档
          （那会让桌面图标直接消失）。
        -->
        <activity-alias
            android:name=".IconWhite"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_white"
            android:roundIcon="@mipmap/ic_launcher_white"
            android:label="@string/app_name"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

