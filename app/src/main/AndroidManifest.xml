            android:exported="false"
            android:label="桌面图标" />

        <!-- 更新日志：装上新版本第一次进界面弹的那次提示，内容就是这个页 -->
        <activity
            android:name=".ChangelogActivity"
            android:exported="false"
            android:label="更新日志" />


        <!-- 中转站：自定义提供方（写进容器里的 DSH 设置，密钥只留本机） -->
        <activity
