        <!--
          常驻服务：维持 dsh web 进程。targetSdk 28 故无需 foregroundServiceType。
          stopWithTask="false"：用户把 App 从最近任务划掉时**不跟着死** ——
          划掉卡片是"不想看界面"，不是"关掉容器"（见 DshService.onTaskRemoved）。
        -->
        <service
            android:name=".DshService"
            android:exported="false"
            android:stopWithTask="false" />

        <!--
          DSH 悬浮窗：在其他应用之上显示一个可交互的 DSH 界面（覆层窗口）。
          必须先是前台服务再 addView —— Android 14+ 会移除"非前台服务添加的 overlay 窗口"。
        -->
        <service
            android:name=".OverlayService"
            android:exported="false" />

        <!--
          实时进度悬浮条（灵动岛）：只读胶囊，浮在其它应用上方显示 agent 状态。
          数据读 /sdcard/.dsh-phone/hud.json（容器里 watchdog / phone_hud 写）。
          开关走 PhoneBridge 的 /hud?on=1|0，以及「手机权限」页的开关。
          权限复用上面已声明的 SYSTEM_ALERT_WINDOW。

          与上面的 OverlayService 的区别：那个是**可交互**的 DSH 浮窗；
          这个是**完全只读**的胶囊（NOT_FOCUSABLE + NOT_TOUCHABLE），
          浮在谁上面都不影响下层应用的交互。
        -->
        <service
            android:name=".HudOverlayService"
            android:exported="false" />

        <!--
          手机控制的无障碍服务。
          注意：它不会修改系统任何东西 —— 只是请求用户在「设置 → 无障碍」里手动开启，
          真正的授权边界是 App 内的应用白名单。
        -->
        <service
            android:name=".DshAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
